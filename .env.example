# sanzar-crm-space/.env.example
# Copia este fichero a `.env` y rellena los valores. `.env` está en .gitignore.
#
# GOOGLE_SHEET_ID admite tanto el ID pelado como el link completo de la hoja
# (config/settings.py::normalize_google_sheet_id extrae el ID del link).
# La hoja debe ser un Google Sheet NATIVO (no un .xlsx subido a Drive) y estar
# compartida como Editor con el `client_email` del service account.
GOOGLE_SHEET_ID=

# Ruta al JSON del service account, relativa a la raíz del proyecto.
GOOGLE_SERVICE_ACCOUNT_PATH=config/credentials/service_account.json

# Segundos entre comprobaciones de "¿ha cambiado el Excel?" (Drive modifiedTime).
# 0 desactiva el poll. Es una llamada barata que NO consume cuota de Sheets API.
REMOTE_SYNC_POLL_SECONDS=60

# TTL (segundos) de la caché de lectura de Google Sheets.
DATA_CACHE_TTL_SECONDS=300

# Opcional — solo si esta app llega a enviar email (no forma parte del MVP):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_USE_TLS=true

APP_THEME=light
